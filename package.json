{
	"name": "kobalte-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "A UI toolkit for building SolidJS applications.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kobaltedev/kobalte.git"
	},
	"license": "MIT",
	"author": "jer3m01 <jer3m01@jer3m01.com>",
	"contributors": [
		"Fabien Marie-Louise <fabienml.dev@gmail.com>",
		"David Di Biase <dave@solidjs.com>"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:libs": "pnpm -F \\!docs -F \\!playground build && pnpm i",
		"changeset": "changeset",
		"ci:release": "pnpm build && changeset publish",
		"ci:version": "changeset version && pnpm i --no-frozen-lockfile && git add .",
		"clean": "turbo run clean && rm -rf node_modules",
		"commit": "git-cz",
		"dev:core": "pnpm -F @kobalte/core dev",
		"dev:docs": "pnpm -F @kobalte/docs dev",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"format": "biome check --write && prettier . --write",
		"check": "biome check",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@changesets/cli": "2.31.0",
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/cz-commitlint": "21.2.0",
		"@solidjs/signals": "2.0.0-beta.15",
		"@solidjs/testing-library": "1.0.0-beta.2",
		"@solidjs/web": "2.0.0-beta.15",
		"@storybook/addon-docs": "^10.4.6",
		"@tailwindcss/postcss": "^4.3.2",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.1.0",
		"@vitest/ui": "^4.1.9",
		"babel-preset-solid": "2.0.0-beta.15",
		"commitizen": "4.3.2",
		"inquirer": "14.0.2",
		"jsdom": "29.1.1",
		"postcss": "8.5.16",
		"prettier": "4.0.0-alpha.10",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup": "4.62.2",
		"rollup-plugin-cleanup": "3.2.1",
		"rollup-plugin-copy": "3.5.0",
		"rollup-plugin-license": "3.7.1",
		"rollup-preset-solid": "3.0.0",
		"solid-js": "2.0.0-beta.15",
		"storybook": "^10.4.6",
		"storybook-solidjs-vite": "^10.5.2",
		"tailwindcss": "^4.3.2",
		"tsup": "8.5.1",
		"turbo": "2.10.3",
		"typescript": "6.0.3",
		"vite": "^8.1.3",
		"vite-plugin-solid": "3.0.0-next.5",
		"vitest": "4.1.9"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
	"overrides": {
		"@solidjs/testing-library": "1.0.0-beta.2",
		"@solid-primitives/a11y": "next",
		"@solid-primitives/controlled-signal": "next",
		"@solid-primitives/event-listener": "next",
		"@solid-primitives/focus": "next",
		"@solid-primitives/form": "next",
		"@solid-primitives/i18n": "next",
		"@solid-primitives/interaction": "next",
		"@solid-primitives/keyboard": "next",
		"@solid-primitives/keyed": "next",
		"@solid-primitives/map": "next",
		"@solid-primitives/media": "next",
		"@solid-primitives/presence": "next",
		"@solid-primitives/props": "next",
		"@solid-primitives/refs": "next",
		"@solid-primitives/resize-observer": "next",
		"@solid-primitives/rootless": "next",
		"@solid-primitives/scroll": "next",
		"@solid-primitives/static-store": "next",
		"@solid-primitives/trigger": "next",
		"@solid-primitives/upload": "next",
		"@solid-primitives/utils": "next"
	}
}
