		"@solidjs/router": "0.16.1",
		"@solidjs/start": "1.3.2",
		"@tanstack/solid-virtual": "3.13.32",
		"clsx": "2.1.1",
		"minisearch": "7.2.0",
		"solid-js": "1.9.14",
		"undici": "8.6.0",
		"vinxi": "0.5.11"
	},
	"devDependencies": {
		"@kobalte/tailwindcss": "0.9.0",
