		"solid",
		"solidjs",
		"ui",
		"library",
		"design-system",
		"components",
		"headless",
		"unstyled",
		"aria"
	],
	"homepage": "https://github.com/kobaltedev/kobalte/tree/main/apps/docs#readme",
	"bugs": {
		"url": "https://github.com/kobaltedev/kobalte/issues"
	},
	"repository": {
