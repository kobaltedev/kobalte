{
	"name": "@kobalte/vanilla-extract",
	"version": "0.5.0",
	"description": "Vanilla Extract utils to style Kobalte components easily",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts"
	},
	"publish": {
		"include": [
			"README.md",
			"src/**/*.ts",
			"package.json"
		],
		"exclude": [
			"dist",
			"node_modules",
			"tsconfig.json"
		]
	}
}
