{
	"name": "@kobalte/tailwindcss",
	"version": "0.9.0",
	"description": "A TailwindCSS plugin for styling Kobalte components with data-* attributes by using modifiers like ui-expanded:*",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts"
	},
	"publish": {
		"include": [
			"README.md",
			"src/**/*.ts",
			"package.json"
		],
		"exclude": [
			"dist",
			"node_modules",
			"tsconfig.json"
		]
	}
}
