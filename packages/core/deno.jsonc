	"publish": {
		"include": [
			"README.md",
			"NOTICE.txt",
			"src/**/*.ts",
			"src/**/*.tsx",
			"package.json"
		],
		"exclude": [
			"dist",
			"dev",
			"node_modules",
			"tsconfig.json",
			"vite.config.ts"
