{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!tsconfig.json",
			"!**/netlify",
			"!**/package.json",
			"!.claude",
			"!**/public"
		]
	},
	"css": {
		"parser": {
			"cssModules": false,
			"allowWrongLineComments": false
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noAutofocus": "off",
				"noNoninteractiveTabindex": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"noSvgWithoutTitle": "off"
			},
			"suspicious": {
				"noEmptyInterface": "off",
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"noDocumentCookie": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.stories.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useValidAnchor": "off"
					}
				}
			}
		}
	]
}
